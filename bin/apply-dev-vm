#!/usr/bin/env bash
set -euo pipefail

hardware_source="${HARDWARE_CONFIGURATION:-/etc/nixos/hardware-configuration.nix}"

find_repo_root() {
  local candidate

  for candidate in "${NIXOS_VMS_REPO:-}" "$PWD" "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.."; do
    [ -n "$candidate" ] || continue

    while [ "$candidate" != "/" ]; do
      if [ -f "$candidate/flake.nix" ] && [ -f "$candidate/hosts/common/default.nix" ]; then
        printf '%s\n' "$candidate"
        return 0
      fi
      candidate="$(dirname "$candidate")"
    done
  done

  echo "Could not find nixos-vms repo root." >&2
  echo "Run this from the repo, or set NIXOS_VMS_REPO=/path/to/nixos-vms." >&2
  return 1
}

# Prints the flake host for this VM: DEV_VM_HOST if set, otherwise the one for the detected hypervisor.
detect_host() {
  local virt

  if [ -n "${DEV_VM_HOST:-}" ]; then
    case "$DEV_VM_HOST" in
      dev-vm-vmware | dev-vm-proxmox)
        printf '%s\n' "$DEV_VM_HOST"
        return 0
        ;;
    esac
    echo "Unknown DEV_VM_HOST: $DEV_VM_HOST" >&2
    echo "Use DEV_VM_HOST=dev-vm-vmware or DEV_VM_HOST=dev-vm-proxmox." >&2
    return 1
  fi

  # systemd-detect-virt exits non-zero when it finds no hypervisor; the case below reports that.
  virt="$(systemd-detect-virt || true)"
  case "$virt" in
    vmware) echo "dev-vm-vmware" ;;
    kvm) echo "dev-vm-proxmox" ;;
    *)
      echo "Unsupported hypervisor from systemd-detect-virt: ${virt:-none}" >&2
      echo "Set DEV_VM_HOST=dev-vm-vmware or DEV_VM_HOST=dev-vm-proxmox to choose a config." >&2
      return 1
      ;;
  esac
}

host="$(detect_host)"
hypervisor="${host#dev-vm-}"
repo_root="$(find_repo_root)"
vm_dir="$repo_root/hosts/dev-vm"
hardware_target="$vm_dir/hardware-configuration.nix"
local_target="$vm_dir/local.nix"

if [ ! -r "$hardware_source" ]; then
  echo "Cannot read hardware config: $hardware_source" >&2
  echo "Run this inside the NixOS VM after nixos-generate-config has created it." >&2
  exit 1
fi

# The flake takes each VM's CPU architecture from this setting rather than hard-coding one.
if ! grep -Eq '^[[:space:]]*nixpkgs\.hostPlatform' "$hardware_source"; then
  echo "$hardware_source does not set nixpkgs.hostPlatform." >&2
  echo "Regenerate it with 'sudo nixos-generate-config', or add" >&2
  echo "  nixpkgs.hostPlatform = lib.mkDefault \"x86_64-linux\";  (or \"aarch64-linux\")" >&2
  exit 1
fi

mkdir -p "$vm_dir"

if [ ! -f "$hardware_target" ] || ! cmp -s "$hardware_source" "$hardware_target"; then
  cp "$hardware_source" "$hardware_target"
  echo "Copied hardware config to $hardware_target"
else
  echo "Hardware config is already up to date at $hardware_target"
fi

if [ -e "$local_target" ]; then
  echo "Keeping existing per-VM settings at $local_target"
  if [ -n "${DEV_VM_HOSTNAME:-}" ]; then
    echo "Ignoring DEV_VM_HOSTNAME; edit networking.hostName in $local_target instead." >&2
  fi
else
  if [ -n "${DEV_VM_HOSTNAME:-}" ]; then
    vm_hostname="$DEV_VM_HOSTNAME"
  else
    machine_id="$(cat /etc/machine-id)"
    vm_hostname="dev-vm-$hypervisor-${machine_id:0:4}"
  fi

  # Matches the DNS-label form NixOS accepts for networking.hostName.
  if ! [[ "$vm_hostname" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]]; then
    echo "Invalid hostname: $vm_hostname" >&2
    echo "Use letters, digits, and hyphens (max 63 characters), not starting or ending with a hyphen." >&2
    exit 1
  fi

  cat >"$local_target" <<EOF
# Settings for this VM only. Created by bin/apply-dev-vm and ignored by git.
{
  networking.hostName = "$vm_hostname";
}
EOF
  echo "Created $local_target with hostname $vm_hostname"
fi

tmp_dir="$(mktemp -d)"
tmp_source="$tmp_dir/nixos-vms"
cleanup() {
  rm -rf "$tmp_dir"
}
trap cleanup EXIT

mkdir -p "$tmp_source"
(
  cd "$repo_root"
  tar --exclude='.git' --exclude='.direnv' -cf - .
) | (
  cd "$tmp_source"
  tar -xf -
)

# Nix writes the lock into the temp copy, which is deleted on exit, so lock it
# here and copy it back to the repo where it can be committed.
nix --extra-experimental-features 'nix-command flakes' flake lock "$tmp_source"
if ! cmp -s "$tmp_source/flake.lock" "$repo_root/flake.lock"; then
  cp "$tmp_source/flake.lock" "$repo_root/flake.lock"
  echo "Updated $repo_root/flake.lock; commit it to pin these inputs."
fi

echo "Applying NixOS configuration: $host"

rebuild=(nixos-rebuild switch --flake "$tmp_source#$host")

if [ "${EUID:-$(id -u)}" -eq 0 ]; then
  "${rebuild[@]}" "$@"
elif [ -x /run/wrappers/bin/sudo ]; then
  /run/wrappers/bin/sudo "${rebuild[@]}" "$@"
else
  sudo "${rebuild[@]}" "$@"
fi

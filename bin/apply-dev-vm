#!/usr/bin/env bash
set -euo pipefail

host="dev-vm"
hardware_source="${HARDWARE_CONFIGURATION:-/etc/nixos/hardware-configuration.nix}"

find_repo_root() {
  local candidate

  for candidate in "${NIXOS_VMS_REPO:-}" "$PWD" "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.."; do
    [ -n "$candidate" ] || continue

    while [ "$candidate" != "/" ]; do
      if [ -f "$candidate/flake.nix" ] && [ -f "$candidate/hosts/$host/default.nix" ]; then
        printf '%s\n' "$candidate"
        return 0
      fi
      candidate="$(dirname "$candidate")"
    done
  done

  echo "Could not find nixos-vms repo root." >&2
  echo "Run this from the repo, or set NIXOS_VMS_REPO=/path/to/nixos-vms." >&2
  return 1
}

repo_root="$(find_repo_root)"
hardware_target="$repo_root/hosts/$host/hardware-configuration.nix"

if [ ! -r "$hardware_source" ]; then
  echo "Cannot read hardware config: $hardware_source" >&2
  echo "Run this inside the NixOS VM after nixos-generate-config has created it." >&2
  exit 1
fi

mkdir -p "$(dirname "$hardware_target")"

if [ ! -f "$hardware_target" ] || ! cmp -s "$hardware_source" "$hardware_target"; then
  cp "$hardware_source" "$hardware_target"
  echo "Copied hardware config to $hardware_target"
else
  echo "Hardware config is already up to date at $hardware_target"
fi

tmp_dir="$(mktemp -d)"
tmp_source="$tmp_dir/nixos-vms"
cleanup() {
  rm -rf "$tmp_dir"
}
trap cleanup EXIT

mkdir -p "$tmp_source"
(
  cd "$repo_root"
  tar --exclude='.git' --exclude='.direnv' -cf - .
) | (
  cd "$tmp_source"
  tar -xf -
)

echo "Applying NixOS configuration: $host"

rebuild=(nixos-rebuild switch --flake "$tmp_source#$host")

if [ "${EUID:-$(id -u)}" -eq 0 ]; then
  "${rebuild[@]}" "$@"
else
  sudo "${rebuild[@]}" "$@"
fi

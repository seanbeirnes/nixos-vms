# bootstrap: sets up a fresh dev VM. Clones this repo, applies the NixOS config, syncs the user
# configs, and prints the steps left for a human. Runs as the flake app
# `nix run github:seanbeirnes/nixos-vms#bootstrap`, which puts clone-or-pull and sync-configs on PATH.
# Arguments go to bin/apply-dev-vm, and so to nixos-rebuild.

repo_url="https://github.com/seanbeirnes/nixos-vms"
repo_dir="$HOME/Desktop/repos/nixos-vms"

if [ "${EUID:-$(id -u)}" -eq 0 ]; then
  echo "Run bootstrap as your normal user, not root. It asks for the sudo password when it applies the config." >&2
  exit 1
fi

clone-or-pull "$repo_url" "$repo_dir"
"$repo_dir/bin/apply-dev-vm" "$@"
sync-configs

# The switch writes the new name to /etc/hostname, but the running system keeps the old one until a reboot.
vm_hostname="$(cat /etc/hostname 2>/dev/null || uname -n)"
vm_user="$(id -un)"

cat <<EOF

Bootstrap finished. This VM is $vm_hostname. What's left:

1. Reboot (sudo reboot), so the VM takes the name $vm_hostname, your login shell
   becomes zsh, and the T3 Code server starts.
2. Pair T3 Code from your Mac: run 't3 pair' on this VM and add the printed link in the
   desktop app (Settings -> Environments -> Add environment). Then sign in to
   Claude Code: run 'claude' on this VM.
3. Run 'gh auth login' on this VM yourself. Choose SSH and let it generate and upload a
   new key (a title like "$vm_hostname" helps you find it later).
4. Ask a T3 agent on $vm_hostname to finish up:
   - trust GitHub's SSH host keys:
       gh api meta --jq '.ssh_keys[] | "github.com " + .' >> ~/.ssh/known_hosts
   - rerun 'sync-configs' (it links agents-private now)
   - sign in to OpenCode, and run 'sudo tailscale up --operator=$vm_user' if Tailscale is
     on, relaying the login codes to you
   Optional, from your Mac: ssh-copy-id $vm_user@$vm_hostname

Details: https://github.com/seanbeirnes/nixos-vms#set-up-a-new-vm
EOF
